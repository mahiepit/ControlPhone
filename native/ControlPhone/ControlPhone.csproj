<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>ControlPhone</AssemblyName>
    <RootNamespace>ControlPhone</RootNamespace>
    <Version>2.0.2</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- FFmpeg (giải mã H.264) + scrcpy-server: lấy từ bộ scrcpy đi kèm dự án -->
  <PropertyGroup>
    <ScrcpyDir>$(MSBuildThisFileDirectory)..\..\vendor\scrcpy-win64-v5.0\</ScrcpyDir>
  </PropertyGroup>
  <!-- bàn phím "chỉ nhập từ PC" (build bằng native/keyboard/build.ps1) -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\keyboard\ControlPhoneKeyboard.apk" Link="ControlPhoneKeyboard.apk" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- bản dịch dùng chung với bản web -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\public\js\lang\*.js" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- scrcpy gốc (mở cửa sổ scrcpy / chế độ OTG) -->
  <ItemGroup>
    <None Include="$(ScrcpyDir)scrcpy.exe;$(ScrcpyDir)SDL3.dll;$(ScrcpyDir)libusb-1.0.dll;$(ScrcpyDir)avformat-*.dll;$(ScrcpyDir)scrcpy.png;$(ScrcpyDir)disconnected.png;$(ScrcpyDir)LICENSE.txt" Link="scrcpy\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ScrcpyDir)avcodec-*.dll;$(ScrcpyDir)avutil-*.dll;$(ScrcpyDir)swresample-*.dll;$(ScrcpyDir)scrcpy-server;$(ScrcpyDir)adb.exe;$(ScrcpyDir)AdbWinApi.dll;$(ScrcpyDir)AdbWinUsbApi.dll" Link="scrcpy\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(ScrcpyDir)avcodec-*.dll;$(ScrcpyDir)avutil-*.dll;$(ScrcpyDir)swresample-*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ScrcpyDir)scrcpy-server" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ScrcpyDir)adb.exe;$(ScrcpyDir)AdbWinApi.dll;$(ScrcpyDir)AdbWinUsbApi.dll" Link="adb\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
