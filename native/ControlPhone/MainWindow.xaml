<Window x:Class="ControlPhone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ControlPhone"
        Title="ControlPhone" Width="1500" Height="920" MinWidth="900" MinHeight="560" WindowState="Maximized"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= thanh trên ================= -->
        <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,7">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnSidebar" Style="{DynamicResource IconGhost}" Content="&#xE700;" ToolTip="Ẩn/hiện thanh bên"/>
                <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Accent}" Margin="6,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ControlPhone" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" Tag="no-i18n"/>
                <Border Background="{DynamicResource Bg3}" CornerRadius="7" Padding="9,4" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Máy đang hoạt động / tổng">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatOnline" Text="0" FontWeight="Bold" Tag="no-i18n"/>
                        <TextBlock x:Name="StatTotal" Text="/0 online" Foreground="{DynamicResource Muted}" Tag="no-i18n"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource Bg3}" CornerRadius="7" Padding="9,4" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Số máy đang chọn">
                    <TextBlock x:Name="StatSel" Text="0 đã chọn" Tag="no-i18n"/>
                </Border>
                <Border Background="{DynamicResource Bg3}" CornerRadius="7" Padding="9,4" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Tổng băng thông video từ tất cả điện thoại">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                        <TextBlock x:Name="StatBw" Text="0" FontWeight="SemiBold" Tag="no-i18n"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnSync" Style="{DynamicResource Ghost}" Margin="2,0,0,0" ToolTip="Tự động đồng bộ khi chọn từ 2 máy trở lên (F3 để tắt tạm)">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="SyncSw" Width="28" Height="16" CornerRadius="8" Background="{DynamicResource Line}" Margin="0,0,7,0">
                            <Ellipse x:Name="SyncKnob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
                        </Border>
                        <TextBlock x:Name="SyncLabel" Text="Đồng bộ" Tag="no-i18n"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSolo" Style="{DynamicResource Primary}" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Đang chỉ hiển thị một số máy (các máy khác tạm dừng xem). Bấm để hiện lại tất cả">
                    <TextBlock x:Name="SoloLabel" Foreground="White" Tag="no-i18n"/>
                </Button>

                <!-- bên phải -->
                <Button x:Name="BtnSettings" DockPanel.Dock="Right" Style="{DynamicResource IconGhost}" Content="&#xE713;" ToolTip="Cài đặt"/>
                <Button x:Name="BtnTheme" DockPanel.Dock="Right" Style="{DynamicResource IconGhost}" Content="&#xE708;" ToolTip="Sáng/Tối"/>
                <Button x:Name="BtnDonate" DockPanel.Dock="Right" Style="{DynamicResource Ghost}" Margin="2,0" ToolTip="Ủng hộ tác giả">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" Foreground="#FF5C8A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ủng hộ"/>
                    </StackPanel>
                </Button>
                <ComboBox x:Name="LangSel" DockPanel.Dock="Right" Width="120" Margin="4,0" ToolTip="Ngôn ngữ / Language" Tag="no-i18n"/>
                <ComboBox x:Name="SortSel" DockPanel.Dock="Right" Width="150" Margin="4,0" ToolTip="Sắp xếp">
                    <ComboBoxItem Tag="num" Content="Theo số thứ tự"/>
                    <ComboBoxItem Tag="name" Content="Theo tên"/>
                    <ComboBoxItem Tag="status" Content="Theo trạng thái"/>
                    <ComboBoxItem Tag="battery" Content="Theo pin"/>
                </ComboBox>
                <Button x:Name="BtnFit" DockPanel.Dock="Right" Style="{DynamicResource IconGhost}" Content="&#xE9A6;" ToolTip="Vừa khít màn hình"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0" ToolTip="Kích thước ô">
                    <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Slider x:Name="SizeSlider" Width="150" Minimum="110" Maximum="520" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnLive" DockPanel.Dock="Right" Style="{DynamicResource Ghost}" Margin="4,0"
                        ToolTip="Tạm dừng/tiếp tục hiển thị TẤT CẢ máy trên máy tính. Muốn tạm dừng riêng 1 máy hoặc 1 nhóm: chuột phải vào máy → Tạm dừng xem">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LiveIcon" Text="&#xE890;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LiveLabel" Text="Đang xem" Tag="no-i18n"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ================= thân ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- thanh bên -->
            <Border x:Name="Sidebar" Width="250" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="SideFoot" DockPanel.Dock="Bottom" Margin="12,8,12,10" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Tag="no-i18n"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,10,10,0">
                            <TextBox x:Name="SearchBox" Tag="Tìm số, tên, IP, serial…" Margin="0,0,0,12"/>
                            <TextBlock Text="Bộ lọc" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="4,0,0,6"/>
                            <StackPanel x:Name="FiltersPanel" Margin="0,0,0,12"/>
                            <DockPanel Margin="4,0,0,6">
                                <Button x:Name="BtnNewGroup" DockPanel.Dock="Right" Style="{DynamicResource IconGhost}" Width="24" Height="22" FontSize="11" Content="&#xE710;" ToolTip="Tạo nhóm"/>
                                <TextBlock Text="Nhóm" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="GroupsPanel" Margin="0,0,0,12"/>
                            <TextBlock Text="Kết nối" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="4,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="BtnConnect" DockPanel.Dock="Right" Style="{DynamicResource Primary}" Width="36" Padding="0" Margin="6,0,0,0" ToolTip="Kết nối qua WiFi">
                                    <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" Foreground="White"/>
                                </Button>
                                <Button x:Name="BtnConnHist" DockPanel.Dock="Right" Style="{DynamicResource IconBtn}" Width="26" Margin="4,0,0,0" FontSize="10" Content="&#xE70D;" ToolTip="Địa chỉ đã dùng"/>
                                <TextBox x:Name="ConnAddr" Tag="192.168.1.10:5555"/>
                            </DockPanel>
                            <StackPanel x:Name="ConnPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- khu chính -->
            <DockPanel Grid.Column="1">
                <!-- thanh thao tác -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
                    <WrapPanel x:Name="ActionBar" VerticalAlignment="Center"/>
                </Border>
                <Grid x:Name="GridArea" Background="Transparent" ClipToBounds="True">
                    <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6" Focusable="False">
                        <ItemsControl x:Name="GridItems" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><local:PhoneTile/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="EmptyIcon" FontFamily="{StaticResource IconFont}" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Tag="no-i18n"/>
                        <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" Tag="no-i18n"/>
                    </StackPanel>
                    <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False">
                        <Rectangle x:Name="Marquee" Visibility="Collapsed" Stroke="{DynamicResource Accent}" StrokeThickness="1" Fill="{DynamicResource AccentSoft}" RadiusX="3" RadiusY="3"/>
                    </Canvas>
                </Grid>
            </DockPanel>

            <!-- màn hình lớn (phóng to) -->
            <Border x:Name="ViewerPane" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="6">
                        <DockPanel>
                            <Button x:Name="VPrev" Style="{DynamicResource IconGhost}" Content="&#xE76B;" ToolTip="Máy trước"/>
                            <Button x:Name="VClose" DockPanel.Dock="Right" Style="{DynamicResource IconGhost}" Content="&#xE711;" ToolTip="Đóng (Esc)"/>
                            <Button x:Name="VNext" DockPanel.Dock="Right" Style="{DynamicResource IconGhost}" Content="&#xE76C;" ToolTip="Máy sau"/>
                            <Border x:Name="VSync" DockPanel.Dock="Right" Background="#26FF9F1C" CornerRadius="9" Padding="8,2" Margin="4,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="VSyncText" Foreground="{DynamicResource Warn}" FontSize="11" Tag="no-i18n"/>
                            </Border>
                            <StackPanel Margin="6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VTitle" FontWeight="Bold" TextTrimming="CharacterEllipsis" Tag="no-i18n"/>
                                <TextBlock x:Name="VSub" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Tag="no-i18n"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="8,6">
                        <WrapPanel x:Name="VFoot"/>
                    </Border>
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="VScreen" Background="Black" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
                            <Grid>
                                <Image x:Name="VImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border x:Name="VOv" Background="#99000000" IsHitTestVisible="False">
                                    <TextBlock Text="Đang mở luồng nét…" Foreground="#CCD0DD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                            <StackPanel x:Name="VTools"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- tiến trình + thông báo (góc dưới phải) -->
        <StackPanel Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" Width="340">
            <ItemsControl x:Name="ToastList"/>
            <ItemsControl x:Name="TaskList"/>
        </StackPanel>

        <!-- kéo thả tệp -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#CC0F1115" IsHitTestVisible="False">
            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14" Margin="30" Background="#22FFFFFF">
                <TextBlock x:Name="DropText" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="40" Tag="no-i18n"/>
            </Border>
        </Border>
    </Grid>
</Window>
