<UserControl x:Class="ControlPhone.PhoneTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="5" SnapsToDevicePixels="True" ToolTipService.InitialShowDelay="900">
    <!-- viền 1px; được chọn / đang phóng to: viền 2px (bù Padding để ô không nhảy kích thước) -->
    <Border x:Name="Frame" Background="{DynamicResource Bg2}" CornerRadius="5" ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SelBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Padding" Value="0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Ok}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Padding" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <!-- tiêu đề -->
            <Grid x:Name="Head" DockPanel.Dock="Top" Height="22" Margin="6,0,5,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding NumText}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- USB / WiFi: đậm = đang dùng, mờ = dự phòng -->
                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,4,0" ToolTip="USB">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUsb}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding UsbActive}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,4,0" ToolTip="WiFi">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWifi}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding WifiActive}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="#33FF9F1C" CornerRadius="3" Padding="4,0" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Root">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="R" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Warn}"/>
                    </Border>
                    <TextBlock Text="{Binding BatteryText}" FontSize="11" ToolTip="{Binding BatteryTip}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BatteryKind}" Value="chg"><Setter Property="Foreground" Value="{DynamicResource Ok}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding BatteryKind}" Value="low"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <!-- màn hình -->
            <!-- màn hình phủ kín ô (không lề đen): khung cao đúng theo tỉ lệ hình, ảnh lấp đầy -->
            <Grid x:Name="Screen" Background="{DynamicResource Bg3}" ClipToBounds="True" Cursor="Hand">
                <Image x:Name="Img" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                <Border x:Name="Ov" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="#B3000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowOverlay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding OverlayKind}" Value="soft"><Setter Property="Background" Value="#80000000"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse x:Name="Spin" Width="22" Height="22" Stroke="#CCD0DD" StrokeThickness="2.5" StrokeDashArray="6 4" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="SpinRot"/></Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ShowSpinner}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="OvIcon" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#E6E8EE" HorizontalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding OverlayTitle}" Foreground="#E6E8EE" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{Binding OverlaySub}" Foreground="#AAB0C0" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
